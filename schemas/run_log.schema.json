{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agent-benchmark.local/schemas/run_log.schema.json",
  "title": "Benchmark Run Log",
  "description": "Complete normalized log for one framework-model execution of one benchmark case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "case_id",
    "task_id",
    "vertical",
    "framework",
    "model",
    "generation_config",
    "prompt_version",
    "case_schema_version",
    "output_schema_version",
    "started_at",
    "completed_at",
    "latency_ms",
    "status",
    "raw_output",
    "parsed_output",
    "output_schema_valid",
    "repair",
    "tool_calls",
    "token_usage",
    "estimated_cost",
    "error"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{0,31}$"
    },
    "vertical": {
      "type": "string",
      "enum": ["healthcare", "ecommerce", "smoke_test"]
    },
    "framework": {
      "$ref": "#/$defs/frameworkRecord"
    },
    "model": {
      "$ref": "#/$defs/modelRecord"
    },
    "generation_config": {
      "$ref": "#/$defs/generationConfig"
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "case_schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "output_schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "End-to-end wall-clock time from run start through completion, including framework retries and tool calls. Do not subtract summed tool latency to infer pure model time because calls may overlap."
    },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"]
    },
    "raw_output": {
      "type": ["string", "null"],
      "description": "Unmodified final output returned by the framework or model."
    },
    "parsed_output": {
      "type": ["object", "null"],
      "description": "Parsed output before any optional repair."
    },
    "output_schema_valid": {
      "type": "boolean",
      "description": "Whether parsed_output passed the applicable output schema without repair."
    },
    "repair": {
      "$ref": "#/$defs/repairRecord"
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "$ref": "tool_call.schema.json"
      },
      "maxItems": 1000
    },
    "token_usage": {
      "$ref": "#/$defs/tokenUsage"
    },
    "estimated_cost": {
      "$ref": "#/$defs/costRecord"
    },
    "evaluation": {
      "type": ["object", "null"],
      "description": "Optional evaluator results added after execution.",
      "additionalProperties": true
    },
    "sanity": {
      "type": ["object", "null"],
      "description": "Optional non-authoritative cross-checks that never override the formal verdict.",
      "additionalProperties": false,
      "properties": {
        "tau3_db": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["db_match", "db_reward"],
          "properties": {
            "db_match": {
              "type": "boolean"
            },
            "db_reward": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "agrees_with_criterion_b": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/errorRecord"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "failed"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "error": {"$ref": "#/$defs/errorRecord"}
        }
      }
    }
  ],
  "$defs": {
    "frameworkRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["langgraph", "crewai", "openai_agents_sdk"]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "adapter_version": {
          "type": ["string", "null"],
          "maxLength": 100
        }
      }
    },
    "modelRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "base_url_label": {
          "type": ["string", "null"],
          "maxLength": 200,
          "description": "Non-secret label for the endpoint. Do not log API keys or credentials."
        }
      }
    },
    "generationConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "max_output_tokens",
        "seed"
      ],
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_output_tokens": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "seed": {
          "type": ["integer", "null"]
        }
      }
    },
    "repairRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "succeeded",
        "repaired_output",
        "changes"
      ],
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "succeeded": {
          "type": ["boolean", "null"]
        },
        "repaired_output": {
          "type": ["object", "null"]
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "maxItems": 100
        }
      }
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "output_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "total_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "costRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "pricing_table_version",
        "pricing_source",
        "calculated_at"
      ],
      "properties": {
        "amount": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "pricing_table_version": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 100,
          "description": "Version of the dated pricing table used for post-run enrichment; null until cost is calculated."
        },
        "pricing_source": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 500,
          "description": "Stable source label or URL for the pricing data; null until cost is calculated."
        },
        "calculated_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "UTC timestamp of post-run cost enrichment; null until cost is calculated."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"amount": {"type": "number"}},
            "required": ["amount"]
          },
          "then": {
            "properties": {
              "pricing_table_version": {"type": "string"},
              "pricing_source": {"type": "string"},
              "calculated_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      ]
    },
    "errorRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "error_type",
        "message",
        "retryable"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "setup",
            "model_call",
            "tool_call",
            "output_parsing",
            "schema_validation",
            "evaluation",
            "unknown"
          ]
        },
        "error_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
