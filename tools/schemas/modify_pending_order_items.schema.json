{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agent-benchmark.local/tools/schemas/modify_pending_order_items.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["order_id", "item_ids", "new_item_ids", "payment_method_id"],
  "properties": {
    "order_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "item_ids": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "new_item_ids": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "payment_method_id": {"type": "string", "minLength": 1, "maxLength": 100}
  }
}
